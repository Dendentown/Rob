{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$code": {
        ".write": "$code.length <= 8"
      }
    },
    "rob": {
      "scores": {
        ".read": true,
        "$jeu": {
          "$joueur": {
            ".write": "$jeu.length <= 40 && $joueur.length <= 24",
            ".validate": "newData.hasChildren(['nom', 'meilleur', 'parties']) && newData.child('nom').isString() && newData.child('nom').val().length <= 16 && newData.child('meilleur').isNumber() && newData.child('parties').isNumber()"
          }
        }
      }
    }
  }
}
